# ─────────────────────────────────────────────
# Interactive shell guard
# ─────────────────────────────────────────────
case $- in
    *i*) ;;
    *) return;;
esac

# ─────────────────────────────────────────────
# Shared dotfiles 
# ─────────────────────────────────────────────
source ~/.dotfiles/shell/shared/env.sh
source ~/.dotfiles/shell/shared/aliases.sh
source ~/.dotfiles/shell/shared/functions.sh

# ─────────────────────────────────────────────
# Shell behavior 
# ─────────────────────────────────────────────
shopt -s histappend
HISTSIZE=1000
HISTFILESIZE=2000

shopt -s checkwinsize

# ─────────────────────────────────────────────
# System-specific behavior
# ─────────────────────────────────────────────

# Detect whether the system is inside a “chroot environment” and store its name.
if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
    debian_chroot=$(cat /etc/debian_chroot)
fi

# ─────────────────────────────────────────────
# Prompt configuration
# ─────────────────────────────────────────────
case "$TERM" in
    xterm-color|*-256color) color_prompt=yes;;
esac

# Build the main prompt
if [ "$color_prompt" = yes ]; then
    PS1='${debian_chroot:+($debian_chroot)}\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ '
else
    PS1='${debian_chroot:+($debian_chroot)}\u@\h:\w\$ '
fi

# Set window title (if in xterm, rxvt)
case "$TERM" in
    xterm*|rxvt*)
        PS1="\[\e]0;${debian_chroot:+($debian_chroot)}\u@\h: \w\a\]$PS1"
        ;;
esac

# ─────────────────────────────────────────────
# Bash completion
# ─────────────────────────────────────────────
if ! shopt -oq posix; then
    if [ -f /usr/share/bash-completion/bash_completion ]; then
        . /usr/share/bash-completion/bash_completion
    elif [ -f /etc/bash_completion ]; then
        . /etc/bash_completion
    fi
fi

# ─────────────────────────────────────────────
# Local overrides 
# ─────────────────────────────────────────────
[ -f ~/.bash_aliases ] && source ~/.bash_aliases
